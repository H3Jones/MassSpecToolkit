{
  "name": "ms-toolkit",
  "version": "0.1.0",
  "description": "Mass spectrometry calculator and plotting web components backed by Rust/WebAssembly",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ion-calculator": {
      "types": "./dist/ion-calculator.d.mts",
      "import": "./dist/ion-calculator.mjs"
    },
    "./fine-isotope-structure": {
      "types": "./dist/fine-isotope-structure.d.mts",
      "import": "./dist/fine-isotope-structure.mjs"
    },
    "./mass-split": {
      "types": "./dist/mass-split.d.mts",
      "import": "./dist/mass-split.mjs"
    },
    "./mass-spectrum": {
      "types": "./dist/mass-spectrum.d.mts",
      "import": "./dist/mass-spectrum.mjs"
    },
    "./table": {
      "types": "./dist/table.d.mts",
      "import": "./dist/table.mjs"
    },
    "./charts": {
      "types": "./dist/charts.d.mts",
      "import": "./dist/charts.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    }
  },
  "scripts": {
    "wasm": "wasm-pack build ../../crates/ms-wasm --target web --out-dir ../../packages/ms-toolkit/src/generated/wasm",
    "dev": "vp dev playground --config vite.config.ts",
    "build": "vp run wasm && vp pack --from-vite",
    "build:browser": "vp build --config vite.browser.config.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@tanstack/table-core": "^9.3.1",
    "comlink": "^4.4.2",
    "dompurify": "^3.3.0",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  }
}
