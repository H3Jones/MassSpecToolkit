ELECTRON_MASS: float
__version__: str

class AtomCount:
    @property
    def symbol(self) -> str: ...
    @property
    def mass_number(self) -> int: ...
    @property
    def isotope_was_specified(self) -> bool: ...
    @property
    def atom_ram(self) -> float: ...
    @property
    def count(self) -> int: ...
    @property
    def total_mass(self) -> float: ...

class FormulaResult:
    @property
    def formula(self) -> str: ...
    @property
    def mass(self) -> float: ...
    @property
    def dbe(self) -> float: ...
    @property
    def atom_counts(self) -> list[AtomCount]: ...

class IonResult:
    @property
    def formula(self) -> str: ...
    @property
    def charge(self) -> int: ...
    @property
    def mass(self) -> float: ...
    @property
    def dbe(self) -> float: ...
    @property
    def mass_to_charge(self) -> float | None: ...
    @property
    def atom_counts(self) -> list[AtomCount]: ...

class MassSplitResult:
    @property
    def formula_a(self) -> FormulaResult: ...
    @property
    def formula_b(self) -> FormulaResult: ...
    @property
    def formula_a_only(self) -> FormulaResult | None: ...
    @property
    def formula_b_only(self) -> FormulaResult | None: ...
    @property
    def mass_difference(self) -> float: ...

class FineIsotopePeakResult:
    @property
    def label(self) -> str: ...
    @property
    def mass(self) -> float: ...
    @property
    def mass_to_charge(self) -> float | None: ...
    @property
    def abundance(self) -> float: ...

class FineIsotopeDistributionResult:
    @property
    def charge(self) -> int: ...
    @property
    def retained_probability(self) -> float: ...
    @property
    def peaks(self) -> list[FineIsotopePeakResult]: ...

def parse_formula(input: str) -> FormulaResult: ...
def evaluate_ion(input: str, charge: int = 0) -> IonResult: ...
def mass_split(formula_a: str, formula_b: str) -> MassSplitResult: ...
def fine_isotope_distribution(
    input: str,
    charge: int = 0,
    *,
    coverage: float = 0.9999,
    max_states: int = 200_000,
) -> FineIsotopeDistributionResult: ...
