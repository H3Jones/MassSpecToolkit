from os import PathLike
from typing import Any, Literal, TypeAlias

RtUnit: TypeAlias = Literal["seconds", "minutes", "milliseconds"]

ELECTRON_MASS: float
__version__: str

class AtomCount:
    @property
    def symbol(self) -> str: ...
    @property
    def mass_number(self) -> int: ...
    @property
    def isotope_was_specified(self) -> bool: ...
    @property
    def atom_ram(self) -> float: ...
    @property
    def count(self) -> int: ...
    @property
    def total_mass(self) -> float: ...

class FormulaResult:
    @property
    def formula(self) -> str: ...
    @property
    def mass(self) -> float: ...
    @property
    def dbe(self) -> float: ...
    @property
    def atom_counts(self) -> list[AtomCount]: ...

class IonResult:
    @property
    def formula(self) -> str: ...
    @property
    def charge(self) -> int: ...
    @property
    def mass(self) -> float: ...
    @property
    def dbe(self) -> float: ...
    @property
    def mass_to_charge(self) -> float | None: ...
    @property
    def atom_counts(self) -> list[AtomCount]: ...

class MassSplitResult:
    @property
    def formula_a(self) -> FormulaResult: ...
    @property
    def formula_b(self) -> FormulaResult: ...
    @property
    def formula_a_only(self) -> FormulaResult | None: ...
    @property
    def formula_b_only(self) -> FormulaResult | None: ...
    @property
    def mass_difference(self) -> float: ...

class FineIsotopePeakResult:
    @property
    def label(self) -> str: ...
    @property
    def mass(self) -> float: ...
    @property
    def mass_to_charge(self) -> float | None: ...
    @property
    def abundance(self) -> float: ...

class FineIsotopeDistributionResult:
    @property
    def charge(self) -> int: ...
    @property
    def retained_probability(self) -> float: ...
    @property
    def peaks(self) -> list[FineIsotopePeakResult]: ...

def parse_formula(input: str) -> FormulaResult: ...
def evaluate_ion(input: str, charge: int = 0) -> IonResult: ...
def mass_split(formula_a: str, formula_b: str) -> MassSplitResult: ...
def fine_isotope_distribution(
    input: str,
    charge: int = 0,
    *,
    coverage: float = 0.9999,
    max_states: int = 200_000,
) -> FineIsotopeDistributionResult: ...

class Peak:
    @property
    def mz(self) -> float: ...
    @property
    def intensity(self) -> float: ...
    @property
    def signal_to_noise(self) -> float | None: ...
    @property
    def retention_time(self) -> float | None: ...

class RunSchema:
    @property
    def layout(self) -> Literal["flat", "scans"]: ...
    @property
    def has_rt(self) -> bool: ...
    @property
    def has_signal_to_noise(self) -> bool: ...

class SourceInfo:
    @property
    def source_id(self) -> str: ...
    @property
    def filename(self) -> str: ...
    @property
    def reader_format(self) -> str: ...
    @property
    def rt_unit(self) -> RtUnit | None: ...
    @property
    def rt_unit_origin(self) -> Literal["declared", "caller", "default"] | None: ...
    @property
    def declared_rt_unit(self) -> RtUnit | None: ...

class RunSummary:
    @property
    def peak_count(self) -> int: ...
    @property
    def scan_count(self) -> int | None: ...
    @property
    def mz_bounds(self) -> tuple[float, float] | None: ...
    @property
    def intensity_bounds(self) -> tuple[float, float] | None: ...
    @property
    def rt_bounds(self) -> tuple[float, float] | None: ...

class Run:
    @classmethod
    def from_text_file(
        cls,
        path: str | PathLike[str],
        format: TxtFormat | None = None,
        *,
        rt_unit: RtUnit | None = None,
        source_id: str | None = None,
    ) -> Run: ...
    @property
    def layout(self) -> Literal["flat", "scans"]: ...
    @property
    def schema(self) -> RunSchema: ...
    @property
    def source(self) -> SourceInfo: ...
    @property
    def summary(self) -> RunSummary: ...
    @property
    def peak_count(self) -> int: ...
    @property
    def scan_count(self) -> int | None: ...
    @property
    def is_empty(self) -> bool: ...
    @property
    def mz(self) -> list[float]: ...
    @property
    def intensity(self) -> list[float]: ...
    @property
    def signal_to_noise(self) -> list[float | None] | None: ...
    @property
    def peak_rt(self) -> list[float | None] | None: ...
    @property
    def peak_ids(self) -> list[int] | None: ...
    def peak(self, row: int) -> Peak: ...
    def peaks(self) -> list[Peak]: ...
    def get_rt_slice(
        self, minimum: float | None = None, maximum: float | None = None
    ) -> Run: ...
    def get_rt_range(self, start: float, end: float) -> Run: ...
    def get_ms_level(self, level: int) -> Run: ...
    def get_mz_slice(
        self, minimum: float | None = None, maximum: float | None = None
    ) -> Run: ...
    def get_intensity_slice(
        self, minimum: float | None = None, maximum: float | None = None
    ) -> Run: ...
    def calculate_tic(self) -> tuple[list[float], list[float]]: ...
    def plot_spectrum(
        self,
        *,
        style: Literal["sticks", "profile"] = "sticks",
        bins: int | None = None,
        mz_range: tuple[float, float] | None = None,
    ) -> Any: ...
    def plot_rt_mz(self) -> Any: ...
    def plot_tic(self) -> Any: ...
    def plot_eic(self, mz_target: float, tolerance: float = 0.0) -> Any: ...
    def plot_kmd(self, base: str | float = "CH2") -> Any: ...

class TxtFormat:
    def __init__(
        self,
        *,
        column_count: int,
        mz_column: int,
        intensity_column: int,
        delimiter: str = ",",
        skip_lines: int = 0,
        signal_to_noise_column: int | None = None,
        retention_time_column: int | None = None,
    ) -> None: ...
    @property
    def delimiter(self) -> str: ...
    @property
    def skip_lines(self) -> int: ...
    @property
    def column_count(self) -> int: ...
    @property
    def mz_column(self) -> int: ...
    @property
    def intensity_column(self) -> int: ...
    @property
    def signal_to_noise_column(self) -> int | None: ...
    @property
    def retention_time_column(self) -> int | None: ...

def guess_txt_format(path: str | PathLike[str]) -> TxtFormat: ...
def read_txt(
    path: str | PathLike[str],
    format: TxtFormat | None = None,
    *,
    rt_unit: RtUnit | None = None,
    source_id: str | None = None,
) -> Run: ...
